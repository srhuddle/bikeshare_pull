+def get_street_name(step):
+    """Extracts street name from ORS instruction if available."""
+    instruction = step.get("instruction", "")
+    if " on " in instruction:
+        return instruction.split(" on ")[-1].strip()
+    if " onto " in instruction:
+        return instruction.split(" onto ")[-1].strip()
+    return step.get("name", "")
